#
# Run the semantic-ui (React) interface next to the bootstrap3 (AngularJS)
# one, to compare them in the browser. Both use the same database, search
# cluster, files and Celery workers: only the theme, the static files and the
# cache keys differ.
#
# Usage:
#   ./scripts/semantic-ui build    # create the instance and build its assets
#   ./scripts/semantic-ui server   # run it on https://127.0.0.1:5001
#   ./scripts/semantic-ui watch    # rebuild its assets on changes
#
# The bootstrap3 interface keeps running with ./scripts/server on port 5000.

set -e

script_path=$(cd "$(dirname "$0")" && pwd)

# The instance of the bootstrap3 interface (``invenio.cfg`` is copied)
main_instance=${INVENIO_INSTANCE_PATH:-$(python -c "import sys; print(sys.prefix)")/var/instance}
instance=${SEMANTIC_UI_INSTANCE_PATH:-${main_instance}-semantic-ui}
port=${SEMANTIC_UI_PORT:-5001}

export INVENIO_INSTANCE_PATH="$instance"
export INVENIO_STATIC_FOLDER="$instance/static"
export FLASK_ENV=development

create_instance() {
    mkdir -p "$instance"
    {
        if [ -f "$main_instance/invenio.cfg" ]; then
            cat "$main_instance/invenio.cfg"
            echo
        fi
        echo "# Added by scripts/semantic-ui"
        echo 'APP_THEME = ["semantic-ui"]'
        echo 'CACHE_KEY_PREFIX = "cds-semantic-ui::"'
    } > "$instance/invenio.cfg"
}

case "$1" in
    build)
        create_instance
        cds collect -v
        cds webpack buildall
        ;;
    server)
        cds run --reload --with-threads -p "$port" \
            --cert "$script_path"/../docker/nginx/test.crt \
            --key "$script_path"/../docker/nginx/test.key
        ;;
    watch)
        cds webpack run start
        ;;
    *)
        echo "Usage: $0 build|server|watch" >&2
        exit 1
        ;;
esac
